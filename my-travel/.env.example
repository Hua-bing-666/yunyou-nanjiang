# Copy to .env.local; never commit real values.
# Public Web JS key, restricted to allowed domains in AMap console.
VITE_AMAP_KEY=
# Recommended: your AMap security proxy URL ending with /_AMapService.
VITE_AMAP_SERVICE_HOST=
# Server-only Web Service key, used for weather and road previews.
AMAP_WEBSERVICE_KEY=
# Without a key the assistant uses clearly labelled local sources.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PROXY_PORT=3001
AI_DAILY_LIMIT=200
# Set local to force local source mode even when a key exists.
AI_MODE=
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
