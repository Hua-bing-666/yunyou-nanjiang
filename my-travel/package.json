{
  "name": "yunyou-nanjiang",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "test": "node --test test/*.test.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node ../scripts/start-production.mjs",
    "test:e2e": "npm run build && playwright test",
    "check": "npm test && npm run test:e2e",
    "format": "prettier --write src server test e2e *.js *.json",
    "format:check": "prettier --check src server test e2e *.js *.json"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "vant": "^4.9.24",
    "vue": "^3.5.31",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "prettier": "^3.9.9",
    "vite": "^8.0.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
